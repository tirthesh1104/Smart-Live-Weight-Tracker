# Supabase PostgreSQL & Auth Configuration (Optional - Local demo mode activates automatically if unconfigured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-publishable-key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Python FastAPI AI Service URL (Optional - Client-side statistical engine activates if offline)
VITE_AI_SERVICE_URL=http://localhost:8000

# Telemetry broadcast refresh interval in seconds
VITE_TELEMETRY_REFRESH_INTERVAL=3

# RailRadar Railway Intelligence API Key (Server-side backend only - Never expose to client/Vite)
